{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless"
      ]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${MAGIC_API_KEY}"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@4.23.0",
        "mcp"
      ]
    }
  }
}
