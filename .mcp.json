{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless"
      ]
    },
    "magic": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@0.2.3"
      ],
      "env": {
        "API_KEY": "${MAGIC_API_KEY}",
        "NODE_USE_ENV_PROXY": "1"
      }
    }
  }
}
